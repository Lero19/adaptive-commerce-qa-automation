{
  "name": "adaptive-commerce-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio-grade Playwright + TypeScript + Cucumber BDD UI automation framework with controlled locator resilience.",
  "scripts": {
    "clean:allure": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "pretest": "npm run clean:allure",
    "test": "cucumber-js --format progress-bar --format allure-cucumberjs/reporter",
    "pretest:smoke": "npm run clean:allure",
    "test:smoke": "cucumber-js --tags \"@smoke\" --format progress-bar --format allure-cucumberjs/reporter",
    "pretest:registration": "npm run clean:allure",
    "test:registration": "cucumber-js --tags \"@registration\" --format progress-bar --format allure-cucumberjs/reporter",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report": "node scripts/merge-report.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.0",
    "dotenv": "^16.4.7",
    "@faker-js/faker": "^9.6.0",
    "allure-commandline": "^2.32.0",
    "allure-cucumberjs": "^3.2.0",
    "allure-js-commons": "^3.2.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "ts-node": "^10.9.2"
  }
}